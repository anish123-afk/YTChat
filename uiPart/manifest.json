{
  "manifest_version": 3,
  "name": "YTChat - AI Assistant for YouTube",
  "version": "1.0.0",
  "description": "Minimalist AI chat sidebar beside YouTube videos with adjustable strictness levels and video ID detection.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle YTChat Beside Video",
    "default_icon": "icons/icon48.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sidebar.html",
        "styles.css",
        "chat.js",
        "icons/*"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ]
}

